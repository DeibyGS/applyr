# applyr configuration — copy to ~/.applyr/applyr.toml
# Docs: https://github.com/DeibyGS/applyr

[general]
threshold = 65          # Minimum compatibility % to recommend applying
followup_days = 10      # Days before follow-up reminder

[weights]
# Relative importance of each scoring topic (auto-normalized)
tech_stack = 30
education = 15
experience = 15
projects = 20
english = 10
cultural_fit = 10

[cv]
# cv_master = "~/.applyr/cv-master.md"
# output_dir = "~/.applyr/cv"
# language — the language generated CVs are written in when an offer does not
#            declare its own. Supported: en, es.
# language = "en"
